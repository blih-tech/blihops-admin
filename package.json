{
  "name": "blihops-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm audit --audit-level=high && pnpm build",
    "preinstall": "node -e \"const ua = process.env.npm_config_user_agent ?? ''; if (!ua.startsWith('pnpm/')) { console.error('Use pnpm'); process.exit(1); }\"",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.17.0 <12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,css,scss,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@floating-ui/react": "^0.27.20",
    "@hookform/resolvers": "^5.7.1",
